import type {
  AnyLexicalExtensionArgument,
  CreateEditorArgs,
  LexicalEditor,
} from 'lexical';
import type {Doc} from '@y/y';
import type {ClientIDRange, YBinding} from '@lexical/y';

/**
 * @lexical/y/headless: EXPERIMENTAL server-side edits, seeds and reads of
 * @lexical/y documents.
 */

export type HeadlessYConfig = {
  extensions?: ReadonlyArray<AnyLexicalExtensionArgument>,
  nodes?: CreateEditorArgs['nodes'],
  root?: string,
  clientIDRange?: ClientIDRange,
  onWarn?: (message: string) => void,
  selfCheck?: boolean,
};

export type CreateHeadlessYEditorOptions = {
  ...HeadlessYConfig,
  state?: Uint8Array | null,
};

// Also disposable with `using` ([Symbol.dispose]), which Flow does not type.
export interface HeadlessYEditor {
  readonly editor: LexicalEditor;
  readonly doc: Doc;
  readonly binding: YBinding;
  readonly warnings: ReadonlyArray<string>;
  dispose(): void;
}

export type YHeadlessErrorCode =
  | 'not-initialized'
  | 'read-only'
  | 'foreign-roots';

declare export class YHeadlessError extends Error {
  readonly code: YHeadlessErrorCode;
  constructor(code: YHeadlessErrorCode, message: string): void;
}

export type EditYStateResult = {
  update: Uint8Array | null,
  state: Uint8Array,
  warnings: Array<string>,
};

export type EditYStateOptions = {
  allowedRoots?: Iterable<string>,
  transact?: (doc: Doc) => void,
  tag?: string | Array<string>,
};

declare export function createHeadlessYEditor(
  options?: CreateHeadlessYEditorOptions,
): HeadlessYEditor;

declare export function seedYState(
  config: HeadlessYConfig,
  $build: () => void,
): Uint8Array;

declare export function editYState(
  state: Uint8Array,
  config: HeadlessYConfig,
  $edit: () => void,
  options?: EditYStateOptions,
): EditYStateResult;

declare export function readYState<T>(
  state: Uint8Array,
  config: HeadlessYConfig,
  $read: () => T,
): T;
